{
  "schemaVersion": "shm-em-phase2c-compose-services-v1",
  "services": [
    {
      "service": "backend",
      "image": "shm-em-reproduction-backend",
      "state": "running",
      "health": "healthy",
      "exitCode": 0,
      "ports": "127.0.0.1:5111->5101/tcp"
    },
    {
      "service": "frontend",
      "image": "shm-em-reproduction-frontend",
      "state": "running",
