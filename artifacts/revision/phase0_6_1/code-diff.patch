+def markdown_table(headers: list[str], rows: list[list[Any]]) -> list[str]:
+    lines = ["| " + " | ".join(headers) + " |", "| " + " | ".join("---" for _ in headers) + " |"]
+    for row in rows:
+        values = [str(value).replace("|", "\\|").replace("\n", " ") for value in row]
+        lines.append("| " + " | ".join(values) + " |")
+    return lines
