# Backend base URL. In development, use the local Spring Boot address; for same-origin deployment, leave it empty and configure the host web server to proxy /api.
VITE_API_BASE_URL=http://localhost:5101

# Default project name, aligned with the formal backend project.
VITE_DEFAULT_PROJECT=SHM-EM Public Reproduction Sample

# Optional AMap web key for the project catalog spatial distribution view.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=


