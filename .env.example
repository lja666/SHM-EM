DB_ADMIN_PASSWORD=replace-with-local-root-password
MYSQL_PASSWORD=replace-with-app-password
SHM_EM_RESTRICTED_DATA_SQL=
SHM_EM_RESTRICTED_CONVERSION_SQL=
SHM_EM_RESTRICTED_VALIDATION_SQL=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=

# Docker Compose public-reference reproduction. Replace both passwords or let
# scripts/reproduce-compose.sh generate process-local random values.
SHM_EM_DATABASE=shm_em_reproduce_compose
SHM_EM_MYSQL_USER=shm_em_reproduce
SHM_EM_MYSQL_ROOT_PASSWORD=replace-with-reproduction-root-password
SHM_EM_MYSQL_PASSWORD=replace-with-reproduction-app-password
# Optional registry prefix for restricted networks, for example:
# SHM_EM_DOCKERHUB_PREFIX=docker.m.daocloud.io/library/
SHM_EM_DOCKERHUB_PREFIX=
SHM_EM_BACKEND_PORT=5101
SHM_EM_FRONTEND_PORT=5173
SHM_EM_PROJECT_CODE=SHM_EM_PUBLIC_SAMPLE
