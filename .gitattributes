* text=auto

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sql text eol=lf
*.md text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf

# Byte-hashed PIT_PRE contract inputs must have deterministic checkout bytes.
src/pit_pre/models/**/*.py text eol=lf
src/pit_pre/models/**/best_params.json text eol=lf
src/pit_pre/runtime-manifest.json text eol=lf
src/pit_pre/requirements.lock.txt text eol=lf

# Portable model artifacts are byte-sensitive binary files.
*.pth binary
*.joblib binary

# Generated diff evidence preserves the original patch bytes.
artifacts/revision/**/*.patch -whitespace

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
