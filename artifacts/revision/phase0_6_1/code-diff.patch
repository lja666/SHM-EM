+    bundles = []
+    artifacts = []
+    if model_root.is_dir():
+        for bundle in sorted(path for path in model_root.iterdir() if path.is_dir()):
+            files = sorted(path for path in bundle.rglob("*") if path.is_file())
+            bundle_artifacts = []
+            for path in files:
